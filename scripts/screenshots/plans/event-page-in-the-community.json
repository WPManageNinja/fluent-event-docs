    {
      "wait": 4000
    },
    {
      "shot": {
        "name": "1.-Event-Page",
        "clip": "viewport"
      }
    },
    {
      "eval": "[...document.querySelectorAll('button')].find(b=>/More actions/i.test(b.getAttribute('aria-label')||''))?.click()"
    },
    {
      "wait": 700
    },
    {
      "shot": {
        "name": "2.-More-Actions-Menu",
        "clip": "viewport"
      }
    }
  ]
