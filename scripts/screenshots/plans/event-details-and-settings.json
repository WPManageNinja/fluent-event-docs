{
  "doc": "docs/events/event-details-and-settings.md",
  "outDir": "public/images/events/event-details",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "admin": "/events/new"
    },
    {
      "scrollTo": {
        "selector": "section.fe-form__section",
        "hasText": "Cover image"
      }
    },
    {
      "shot": {
        "name": "1.-Cover-Image-Section",
        "clip": {
          "element": {
            "selector": "section.fe-form__section",
            "hasText": "Cover image"
          },
          "pad": 20
        }
      }
    },
    {
      "scrollTo": {
        "selector": "section.fe-form__section",
        "hasText": "Visibility"
      }
    },
    {
      "shot": {
        "name": "2.-Visibility-Options",
        "clip": {
          "element": {
            "selector": "section.fe-form__section",
            "hasText": "Visibility"
          },
          "pad": 20
        }
      }
    },
    {
      "viewport": {
        "width": 1440,
        "height": 820
      }
    },
    {
      "scrollTo": {
        "selector": "section.fe-form__section",
        "hasText": "Description"
      }
    },
    {
      "click": ".fe-markdown-editor .ProseMirror"
    },
    {
      "wait": 300
    },
    {
      "eval": "document.execCommand('insertText', false, '/'); window.scrollBy(0,230)"
    },
    {
      "wait": 900
    },
    {
      "shot": {
        "name": "3.-Description-Editor",
        "clip": "app"
      }
    },
    {
      "admin": "/events/new"
    },
    {
      "wait": 1500
    },
    {
      "scrollTo": {
        "selector": "section.fe-form__section",
        "hasText": "Date and time"
      }
    },
    {
      "shot": {
        "name": "4.-Date-And-Time",
        "clip": {
          "element": {
            "selector": "section.fe-form__section",
            "hasText": "Date and time"
          },
          "pad": 20
        }
      }
    },
    {
      "scrollTo": {
        "selector": "section.fe-form__section",
        "hasText": "Venue type"
      }
    },
    {
      "shot": {
        "name": "5.-In-Person-Venue",
        "clip": {
          "element": {
            "selector": "section.fe-form__section",
            "hasText": "Venue type"
          },
          "pad": 20
        }
      }
    },
    {
      "click": {
        "selector": "section.fe-form__section :is(label,button,[role=radio])",
        "hasText": "Online"
      }
    },
    {
      "wait": 900
    },
    {
      "scrollTo": {
        "selector": "section.fe-form__section",
        "hasText": "Venue type"
      }
    },
    {
      "shot": {
        "name": "6.-Online-Venue",
        "clip": {
          "element": {
            "selector": "section.fe-form__section",
            "hasText": "Venue type"
          },
          "pad": 20
        }
      }
    }
  ],
