{
  "doc": "docs/calendars/create-and-edit-a-calendar.md",
  "outDir": "public/images/calendars/create-edit",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "admin": "/calendars"
    },
    {
      "shot": {
        "name": "1.-Create-Calendar-Button",
        "clip": "app",
        "arrows": [
          {
            "target": {
              "text": "Create Calendar"
            },
            "from": "left",
            "len": 150
          }
        ]
      }
    },
    {
      "admin": "/calendars/new"
    },
    {
      "shot": {
        "name": "2.-Create-Calendar-Form",
        "clip": "app",
        "crop": "auto"
      }
    },
    {
      "eval": "(document.querySelector('.fe-form__swatch--picker .el-color-picker__trigger')||document.querySelector('.el-color-picker__trigger'))?.click()"
    },
    {
      "wait": 1000
    },
    {
      "shot": {
        "name": "3.-Custom-Color-Picker",
        "clip": "app"
      }
    },
    {
      "admin": "/calendars/1/edit"
    },
    {
      "wait": 1500
    },
    {
      "admin": "/calendars/1/edit"
    },
    {
      "shot": {
        "name": "4.-Edit-Calendar-Form",
        "clip": "app",
        "crop": "auto"
      }
    },
    {
      "admin": "/calendars/1/edit"
    },
    {
      "wait": 1500
    },
    {
      "click": {
        "text": "Change"
      }
    },
    {
      "wait": 900
    },
    {
      "shot": {
        "name": "5.-Change-Slug-Dialog",
        "clip": "app"
      }
    }
  ],
