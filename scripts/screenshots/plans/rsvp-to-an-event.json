{
  "doc": "docs/community/rsvp-to-an-event.md",
  "outDir": "public/images/community/rsvp",
  "viewport": {
    "width": 1440,
    "height": 1250
  },
  "steps": [
    {
      "viewport": {
        "width": 1440,
        "height": 1150
      }
    },
    {
      "front": "/portal/space/events-meetups/event/monthly-community-call-november",
      "waitUntil": "load",
      "contentWidth": false,
      "hideThemeHeader": false,
      "login": false
    },
    {
      "wait": 1800
    },
    {
      "shot": {
        "name": "1.-Log-In-To-RSVP",
        "clip": "viewport"
      }
    },
    {
      "front": "/portal/space/events-meetups/event/holiday-virtual-mixer",
      "waitUntil": "load",
      "contentWidth": false,
      "hideThemeHeader": false,
      "login": false
    },
    {
      "wait": 1800
    },
    {
      "click": {
        "selector": "button",
        "hasText": "Register"
      }
    },
    {
      "wait": 900
    },
    {
      "shot": {
        "name": "2.-Open-Event-Register-Form",
        "clip": "viewport"
      }
    },
    {
      "front": "/portal/space/events-meetups/event/monthly-community-call-november",
      "waitUntil": "load",
      "contentWidth": false,
      "hideThemeHeader": false,
      "login": true
    },
    {
      "wait": 1800
    },
    {
      "click": {
        "text": "Interested?"
      }
    },
    {
      "wait": 900
    },
    {
      "shot": {
        "name": "3.-Going-Or-Not-Going",
        "clip": "viewport"
      }
    },
    {
      "front": "/portal/events",
      "waitUntil": "load",
      "contentWidth": false,
      "hideThemeHeader": false,
      "login": true
    },
    {
      "wait": 3500
    },
    {
      "eval": "[...document.querySelectorAll('*')].find(e=>e.children.length===0&&e.textContent.trim()==='Past')?.click()"
    },
    {
      "wait": 2500
    },
    {
      "shot": {
        "name": "4.-Ended-Event",
        "clip": "viewport"
      }
    }
  ],
  "site": "http://crm.local",
  "user": "tajul",
  "pass": "12345"
}